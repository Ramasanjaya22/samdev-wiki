# GitHub Token Example (.env)
# Copy to .env and set your actual values
# NEVER commit .env to version control!

# GitHub Personal Access Token
# Required scopes: repo, workflow, write:org, read:org
# Generate at: https://github.com/settings/tokens
GH_TOKEN=your_ghp_token_here

# Git Configuration
GIT_AUTHOR_NAME=Agent Swarm
GIT_AUTHOR_EMAIL=agent@footygraph.com

# Repository Configuration
REPO_URL=https://github.com/your-org/your-repo
DEFAULT_BRANCH=main
WORK_DIR=/opt/agent-workspace

# Branch settings
BRANCH_PREFIX=agent
COMMIT_STYLE=conventional