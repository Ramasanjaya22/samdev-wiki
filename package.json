{
  "name": "samdev-wiki",
  "version": "0.1.0",
  "description": "Hermes setup documentation with Svelte frontend planning",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.ts,.svelte 2>/dev/null || echo 'No lint config'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "echo 'No tests yet'",
    "check": "npm run format:check && npm run lint",
    "prerelease": "npm run build"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "svelte": "^5.0.0",
    "vite": "^5.0.0"
  },
  "keywords": ["hermes", "documentation", "svelte", "setup"],
  "author": "Agent Swarm",
  "license": "MIT",
  "standard": {
    "env": {
      "browser": true,
      "node": true
    }
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "printWidth": 100
  }
}